@startuml
skinparam componentStyle rectangle
skinparam handwritten false
skinparam backgroundColor #FFFFFF
skinparam packageBackgroundColor transparent
skinparam componentBackgroundColor #EBF4FA
skinparam componentBorderColor #2B547E
skinparam arrowColor #2B547E

title **Minecraft Castle Diffusion Generation**\n(LongSANA Text-to-Video Architecture Strategy)

package "Stage 1 & 1b: Data Preparation Workflow\n[01_data_preparation.py Orchestrator]" {
    [Minecraft Worlds\n(Curated Builds)] as RawData
    
    node "Data Extraction (world_processor.py)" {
        [WorldWrapper\n(MCA Extraction)] as Extractor
        [mcmap\n(Screenshot Renderer)] as MCMap
    }

    [3D Compressed Volumes\n(.b2frame)] as VoxelGrid
    [Top-Down 2D Screenshots\n(.png)] as IsoImages
    
    node "Caption Generation (generate_captions.py)" {
        [Local vLLM\n(Qwen-VL-4B)] as VLM
    }
    
    [Video Tensor .npy\nShape: (Y, X, Z, 3)] as VideoTensor
    [Text Caption .txt\n"A massive stone castle..."] as Caption

    RawData --> Extractor : Scrape & Load MCA
    RawData --> MCMap : Render World Regions
    
    Extractor --> VoxelGrid : Save Binary Volumes
    MCMap --> IsoImages : Save Screenshots
    
    VoxelGrid --> VideoTensor : Transpose Y to Time
    IsoImages --> VLM : Visual Context Input
    VLM --> Caption : Generate Description
}

package "Stage 2 & 3: Model Training Loop" {
    [02_dataset_loader.py\n(PyTorch Dataset)] as DataLoader

    node "Base Model Preparation" {
        [Pre-trained LongSANA\nDiT Weights] as LongSANA_Init
        [Frozen Text Encoder\n(Gemma-2B / T5)] as TextEnc
    }

    node "Training Process (03_training_setup.py)" {
        [SANA 3D VAE Encoder] as VAE_Enc
        [Gaussian Noise\nAddition Process] as NoiseAdd
        [LongSANA Diffusion Transformer\n(Block-Wise Autoregressive)] as DiT_Train
        [Loss Calculation\n(MSE)] as Loss
    }

    [Dataset Folder\n(Video Tensor .npy + Text Caption .txt)] as DatasetFolder
    
    VideoTensor --> DatasetFolder
    Caption --> DatasetFolder
    
    DatasetFolder --> DataLoader : Load Batched Pairs

    DataLoader --> VAE_Enc : Raw Video Tensors
    DataLoader --> TextEnc : Text Prompts

    VAE_Enc --> NoiseAdd : Latent Video
    NoiseAdd --> DiT_Train : Noisy Latent Video
    TextEnc --> DiT_Train : Cross-Attention Embeddings
    LongSANA_Init --> DiT_Train : Initialize Weights

    DiT_Train --> Loss : Predict Original Noise
    Loss -.left.> DiT_Train : Backpropagate & Update Weights
}

package "Stage 4 & 5: Inference Generation Pipeline" {
    actor "Minecraft User" as User
    [04_inference_generation.py] as InfPipeline
    [Fine-Tuned LongSANA Model] as FTModel
    [SANA 3D VAE Decoder] as VAE_Dec

    [Generated Video Tensor\nShape: (H, 256, 256, 3)] as GenVideo
    [Spatial Transpose\nShape: (256, 256, H, 3)] as GenSpatial

    [05_post_processing.py\n(scipy cKDTree)] as PP
    [Discrete Block Array\nBlock IDs instead of RGB] as FinalDict
    [Minecraft Game Injection\nAmulet / .mca] as FinalOutput

    User --> InfPipeline : Text Prompt:\n"A towering desert palace"
    InfPipeline --> FTModel : Send Prompt & Gaussian Noise
    FTModel --> VAE_Dec : Denoised Latent Video
    VAE_Dec --> GenVideo : Decode to RGB Slices

    GenVideo --> GenSpatial : Transpose Time to Height (Y)
    GenSpatial --> PP : Continuous Raw RGB values
    PP --> FinalDict : Snap to nearest valid Block ID
    FinalDict --> FinalOutput : Load into game world
}

DiT_Train -[hidden]down-> FTModel
@enduml
